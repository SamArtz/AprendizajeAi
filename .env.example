# Copia a .env y completa los datos reales. No subas .env a GitHub.
PGHOST=localhost
PGPORT=5432
PGDATABASE=adaptia
PGUSER=
PGPASSWORD=
# Alternativamente configura DATABASE_URL (tiene prioridad).
# DATABASE_URL=postgresql://usuario:password@localhost:5432/base

# Opcional: URL EXACTA que usas en el navegador (origen sin /register).
# En desarrollo puedes omitir APP_URL; se valida el Host de la petición.
# No descomentes el ejemplo sin sustituirlo por tu URL real.
# APP_URL=https://tu-dominio.com
# En producción la aplicación requiere HTTPS para la cookie de sesión.

# Piloto jurídico: correos de cuentas registradas autorizadas, separados por comas.
# Sin esta lista, nadie tiene acceso al piloto, aunque haya iniciado sesión.
CHAT_JURIDICO_EMAILS=
# Activa solo para pruebas internas con el compendio pendiente de revisión.
# false conserva exclusivamente búsqueda documental y no llama a OpenAI.
CHAT_JURIDICO_PRUEBA_IA=false
# Clave solo en el servidor; nunca NEXT_PUBLIC_ ni en GitHub.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
